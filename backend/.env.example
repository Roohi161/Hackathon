# ============================
# Hackathon Central — Environment
# ============================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hackathon_central"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET="your-jwt-secret-min-32-chars-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# CORS
CORS_ORIGIN="http://localhost:3002"

# OAuth (optional — add when ready)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GITHUB_CALLBACK_URL="http://localhost:5000/api/v1/auth/github/callback"

# File Storage (optional — defaults to local)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# AWS_S3_BUCKET=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""

# Email (optional — defaults to console logging)
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="noreply@hackathon-central.com"

# Frontend URL (for email links)
FRONTEND_URL="http://localhost:3002"
